{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "release.schema.json",
  "title": "Release file (release.yaml)",
  "type": "object",
  "properties": {
    "version": {
      "$ref": "common.schema.json#/$defs/semver"
    },
    "canonical_model_version": {
      "type": "string",
      "pattern": "^manufacturing-v\\d+\\.\\d+$"
    },
    "changes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "version": {
            "$ref": "common.schema.json#/$defs/semver"
          },
          "date": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false,
        "required": [
          "version",
          "summary"
        ]
      },
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "canonical_model_version",
    "changes"
  ]
}
